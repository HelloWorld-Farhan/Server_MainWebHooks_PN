# Database — NODE_ENV=development uses DATABASE_URL_LOCAL; production uses DATABASE_URL (Atlas)
DATABASE_URL_LOCAL=mongodb://127.0.0.1:27017/propnex-main?replicaSet=rs0
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/propnex
DATABASE_URL_ATLAS=
MONGODB_URI=

# Server
PORT=3004
NODE_ENV=development
MAIN_SERVER_URL=http://localhost:3004
MAIN_WEBSITE_URL=http://localhost:3000

# Clerk
CLERK_SECRET_KEY=
CLERK_WEBHOOKS_ENABLED=false
CLERK_WEBHOOK_SECRET=

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Google OAuth (Sheets, Drive, Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3004/api/integrations/google/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Agent server internal API (post-call Google Sheets sync)
AGENT_SERVER_API_KEY=

# Email (employee invitations)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Debug
GRAPHQL_DEBUG=0
