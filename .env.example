# MongoDB Atlas
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/propnex
DATABASE_URL_ATLAS=
MONGODB_URI=

# Server
PORT=3004
NODE_ENV=development
MAIN_SERVER_URL=http://localhost:3004
# Production: https://voice.propnexai.com
MAIN_WEBSITE_URL=http://localhost:3000

# Clerk
# Use the publishable and secret keys from the same Clerk instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional comma-separated additional frontend origins. Localhost is added
# automatically outside production and rejected when NODE_ENV=production.
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOKS_ENABLED=false
CLERK_WEBHOOK_SECRET=

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Google OAuth (Sheets, Drive, Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3004/api/integrations/google/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Agent server internal API (post-call Google Sheets sync)
AGENT_SERVER_API_KEY=

# Email (employee invitations)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Debug
GRAPHQL_DEBUG=0
