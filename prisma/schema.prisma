// ─── AI Dialer ─────────────────────────────────────────────────────────────────

model Channel {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  companyId          String        @db.ObjectId
  number             String
  status             ChannelStatus @default(AVAILABLE)
  aiAgentId          String?       @db.ObjectId
  lastStatusChangeAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aiAgent     AiAgent?     @relation(fields: [aiAgentId], references: [id])
  leads       Lead[]
  dialerCalls DialerCall[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model DialerCall {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String          @db.ObjectId
  leadId          String          @db.ObjectId
  channelId       String          @db.ObjectId
  aiAgentId       String          @db.ObjectId
  callStatus      AgentCallStatus
  durationSeconds Int             @default(0)
  assignedNumber  String?
  customerPhone   String?
  customerName    String?
  customerEmail   String?
  customerAddress String?
  customerCity    String?
  customerState   String?
  customerZip     String?
  customerCountry String?
  recordingUrl    String?
  transcript      String?
  summary         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead            Lead                   @relation(fields: [leadId], references: [id])
  channel         Channel                @relation(fields: [channelId], references: [id])
  aiAgent         AiAgent                @relation(fields: [aiAgentId], references: [id])
  analysis        CallAnalysis?
  events          CallEvent[]
  integrationLogs DialerIntegrationLog[]

  @@index([companyId, createdAt])
  @@index([companyId, leadId])
  @@index([companyId, channelId])
}

model CallAnalysis {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  dialerCallId     String   @unique @db.ObjectId
  sentiment        String?
  intent           String?
  interested       Boolean  @default(false)
  followUpRequired Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dialerCall DialerCall @relation(fields: [dialerCallId], references: [id], onDelete: Cascade)
}

model CallEvent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  dialerCallId String   @db.ObjectId
  event        String
  timestamp    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dialerCall DialerCall @relation(fields: [dialerCallId], references: [id], onDelete: Cascade)

  @@index([dialerCallId, timestamp])
}

model DialerIntegrationLog {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  dialerCallId String                  @db.ObjectId
  type         DialerIntegrationType
  status       DialerIntegrationStatus @default(PENDING)
  response     Json                    @default("{}")
  retryCount   Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  dialerCall DialerCall @relation(fields: [dialerCallId], references: [id], onDelete: Cascade)

  @@index([dialerCallId, type])
  @@index([dialerCallId, createdAt])
}

// ─── Branches (generic business units) ─────────────────────────────────────────

model Branch {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String       @db.ObjectId
  name           String
  status         BranchStatus @default(ACTIVE)
  address        String?
  phone          String?
  email          String?
  notes          String?
  customFields   Json         @default("{}")
  /// Per-branch AI toggle. AI configuration is stored per branch, not globally.
  aiEnabled      Boolean      @default(false)
  /// Branch-specific system prompt controlling the AI agent behavior.
  systemPrompt   String?
  /// Extensible AI settings bag (model, temperature, knowledgeBase, voice, etc.).
  aiConfig       Json         @default("{}")
  lastActivityAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads        Lead[]
  callLogs     CallLog[]
  documents    BranchDocument[]
  activities   BranchActivity[]
  memberAccess MemberBranchAccess[]
  agents       AiAgent[]
  invitation   BranchInvitation?

  @@index([companyId, status])
  @@index([companyId, name])
  @@index([companyId, lastActivityAt])
  @@index([companyId, aiEnabled])
}

model BranchDocument {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String   @db.ObjectId
  branchId     String   @db.ObjectId
  name         String
  url          String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
}

model BranchActivity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  branchId  String   @db.ObjectId
  type      String
  summary   String
  actorId   String?  @db.ObjectId
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
}

enum BranchInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model BranchInvitation {
  id                  String                 @id @default(auto()) @map("_id") @db.ObjectId
  companyId           String                 @db.ObjectId
  branchId            String                 @unique @db.ObjectId
  email               String
  token               String                 @unique
  clerkInvitationId   String?
  clerkOrganizationId String?
  status              BranchInvitationStatus @default(PENDING)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  sentAt              DateTime               @default(now())
  acceptedAt          DateTime?
  expiresAt           DateTime

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
